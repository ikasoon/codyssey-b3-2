# 기존 .env 파일이 있으면 덮어쓰지 말고 필요한 항목만 설정하세요.
openrouter_api_key=
LLM_PROVIDER=openrouter
# 모델 지정은 필수입니다. 아래 ID는 예시이며 코드 기본값은 없습니다.
LLM_MODEL=openai/gpt-4.1-mini

# 다른 제공자 사용 시 설정합니다. 키는 선택한 제공자에만 전달됩니다.
# ANTHROPIC_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY_ENV=LLM_API_KEY

# 선택 사항: 생략하면 Settings의 기본값을 사용합니다.
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=2048
# LLM_TIMEOUT_SECONDS=60
# GITDRAFT_GIT_TIMEOUT_SECONDS=30
# GITDRAFT_SAFE_MODE=true
